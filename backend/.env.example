# ============================================================================
#  Jibble Backend — Environment Variables
#  Copy this file to .env and fill in all required values before starting.
#  ⚠️  Never commit .env to version control.
# ============================================================================

# ── General ──────────────────────────────────────────────────────────────────
NODE_ENV=development                    # development | test | staging | production
PORT=8080                               # HTTP server port

# ── Database (Neon PostgreSQL) ────────────────────────────────────────────────
DATABASE_URL=                           # postgresql://user:pass@host/dbname?sslmode=require

# ── Redis (Upstash / self-hosted) ─────────────────────────────────────────────
REDIS_URL=                              # redis://default:password@host:6379
BULLMQ_REDIS_URL=                       # separate Redis URL for BullMQ workers (optional — falls back to REDIS_URL)

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=                      # min 32 chars — generate with: openssl rand -base64 48
JWT_REFRESH_SECRET=                     # min 32 chars — different from access secret
JWT_ACCESS_EXPIRES_IN=15m              # short-lived access token
JWT_REFRESH_EXPIRES_IN=7d             # long-lived refresh token

# ── AWS / S3 ──────────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=                      # IAM user access key
AWS_SECRET_ACCESS_KEY=                  # IAM user secret key
AWS_REGION=us-east-1                    # AWS region where S3 buckets live
S3_BUCKET_PROFILE=                      # e.g. jibble-profile-pictures
S3_BUCKET_POSTS=                        # e.g. jibble-posts-media
S3_BUCKET_STORIES=                      # e.g. jibble-stories-media

# ── CloudFront ────────────────────────────────────────────────────────────────
CLOUDFRONT_URL=                         # https://d1234abcdef.cloudfront.net

# ── CORS ──────────────────────────────────────────────────────────────────────
CLIENT_BASE_URL=http://localhost:3000   # Allowed origin for CORS + JWT cookies

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000             # Rolling window in ms (default: 60 s)
RATE_LIMIT_GLOBAL_MAX=100              # Max requests per window (all routes)
RATE_LIMIT_AUTH_MAX=10                 # Max requests per window (/auth routes)
RATE_LIMIT_CHAT_MAX=600               # Max requests per window (/messages routes)
RATE_LIMIT_POST_MAX=60                # Max requests per window (/posts routes)

# ── Feature Flags (optional) ──────────────────────────────────────────────────
FEATURE_FLAGS=                          # Comma-separated or JSON: "stories,explore"
